# Optional. Copy to .env in the repository root to override local defaults.
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info
# Server-side Vite proxy setting; never put credentials in VITE_* variables.
API_PROXY_TARGET=http://127.0.0.1:3001
WEB_PORT=5173
# Development uses embedded PostgreSQL at .data/planner by default.
# Standard PostgreSQL (required with NODE_ENV=production):
# DATABASE_URL=postgresql://hub:local-development-password@127.0.0.1:5432/hub
WEB_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
# Production also requires HTTPS origins; first enrollment requires SETUP_TOKEN
# (at least 32 random characters). Remove SETUP_TOKEN after creating the owner.
# NODE_ENV=production
# SETUP_TOKEN=
# Optional read-only Canvas feed. Keep the private URL here/server environment,
# never in VITE_* variables, source, screenshots, logs, or chat.
# CANVAS_CALENDAR_FEED_URL=
# Optional read-only Canvas API, personal testing only; multi-user needs OAuth.
# Keep this token on the server. Never paste it into chat or VITE_* variables.
# CANVAS_API_TOKEN=
# Optional AI preflight profiles. Empty by default; no provider execution exists.
# JSON fields: alias, adapter, model, credentialEnv, enabled,
# maxInputCharacters (1-48000), maxOutputTokens (1-32000).
# Credential references must be AI_SECRET_* names, held only on the server.
# Profiles declare models; reachability/model support remains unchecked.
# AI_PROVIDER_PROFILES=[]
# AI_SECRET_ROUTINE=
